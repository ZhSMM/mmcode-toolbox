{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mavis Code Toolbox",
  "version": "0.2.0",
  "identifier": "com.minimax.mmcode-toolbox",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Mavis Code Toolbox",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "开发者桌面工具集",
    "longDescription": "基于 Tauri + Vue3 + SQLite 的开发者桌面工具集合,左侧菜单归类工具,覆盖 JSON、Base64、加密、生成器等常用操作。"
  }
}